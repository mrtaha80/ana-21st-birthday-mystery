# Copy to .env.local; never commit secrets or passwords.
# The Supabase publishable/anon key is public; never expose service_role/secret keys in VITE_*.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_TAHA_EMAIL=YOUR_TAHA_LOGIN_EMAIL
